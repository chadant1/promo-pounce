{
  "name": "Promo Pounce",
  "short_name": "Pounce",
  "description": "Pounce on promo codes, coupons and sales. Search any item, save the best deals and rank them by category.",
  "start_url": "./#search",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#110922",
  "theme_color": "#110922",
  "categories": ["shopping", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Hot deals", "url": "./#hot" },
    { "name": "My stash", "url": "./#stash" }
  ]
}
